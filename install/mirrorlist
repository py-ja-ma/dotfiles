# Pinned mirrors for the installer and new hosts (decisions/0010). Nothing at install
# time talks to archlinux.org (unreachable from the home LAN); reflector
# refreshes this list later when it can, and keeps it when it cannot.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
Server = https://mirrors.kernel.org/archlinux/$repo/os/$arch
