# The Arch ISO the installer is tested with (decisions/0010). install/get-iso.sh
# downloads it from a mirror and checks BOTH: the sha256 below and Arch's release
# signature, against the release key's fingerprint pinned here (fetched by WKD from
# openpgpkey.archlinux.org, which this LAN reaches). Bump: new VERSION + SHA256 from
# the mirror's sha256sums.txt, then run get-iso.sh — it refuses a bad signature.
VERSION=2026.10.01
SHA256=684ded26c63240ff4a41e8c25ee84ea6da233f557364821f13d12c2b0a9059a5
RELEASE_KEY_FPR=3E80CA1A8B89F69CBA57D98A76A5EF9054449A5C
RELEASE_KEY_UID=pierre@archlinux.org
MIRROR=https://geo.mirror.pkgbuild.com/iso
