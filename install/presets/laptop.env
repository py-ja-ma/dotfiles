# laptop — lantern: one LUKS2 volume (TPM2 + PIN enrolled later, decisions/0011),
# one btrfs pool, a swapfile the size of RAM for hibernation.
PRESET_DESC="laptop: ESP 4 GiB at /efi, LUKS2 + btrfs on the rest, swapfile for hibernation"
ESP_MIB=4096
ENCRYPT=luks2
SYS_GIB=0
SWAP=hibernate
SERIAL_CONSOLE=0
DATA_SUBVOLS="@containers:/var/lib/containers"
