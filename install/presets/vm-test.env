# vm-test — the QEMU bench (tier T2, tests/README.md): one disk, no LUKS,
# a small system pool so the two-pool code path runs too, serial console, sshd on.
PRESET_DESC="vm-test: ESP 1 GiB, btrfs system pool 12 GiB + data pool, serial console"
ESP_MIB=1024
ENCRYPT=none
SYS_GIB=12
SWAP=zram
SERIAL_CONSOLE=1
DATA_SUBVOLS="@vm:/data/vm:nocow"
