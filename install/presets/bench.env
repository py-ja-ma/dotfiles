# bench — cabin (decisions/0017): Arch owns the two NVMe disks; the SATA disks belong to
# Windows (1 TB, installed first, alone) and to Debian/Fedora/NixOS (2 TB, after Arch).
#   --disk       NVMe 1: ESP 4 GiB at /efi, btrfs system pool 512 GiB, btrfs data pool on
#                the rest (games, the emulation tree, recordings: kept across reinstalls)
#   --work-disk  NVMe 2: one btrfs work pool (VM images, ML models and datasets,
#                containers, scratch for testing products)
PRESET_DESC="bench: NVMe 1 = ESP 4 GiB + system 512 GiB + data pool; NVMe 2 = work pool; no LUKS"
ESP_MIB=4096
ENCRYPT=none
SYS_GIB=512
SWAP=zram
SERIAL_CONSOLE=0
WORK_REQUIRED=1
# data pool subvolumes (NVMe 1): name:mountpoint[:nocow]
DATA_SUBVOLS="@games:/data/games @emulation:/data/emulation @recordings:/data/recordings"
# work pool subvolumes (NVMe 2)
WORK_SUBVOLS="@vm:/data/vm:nocow @ml:/data/ml @containers:/var/lib/containers @scratch:/data/scratch"
