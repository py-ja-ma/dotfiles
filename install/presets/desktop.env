# desktop — campfire (the recorder) and other single-disk desktops: the NVMe only, no encryption, two btrfs pools
# (decisions/0011): a system pool that a reinstall wipes, and a data pool that keeps
# games, ROMs, ML data, VM images and recordings across reinstalls.
PRESET_DESC="desktop: ESP 4 GiB at /efi, btrfs system pool ${SYS_GIB:-256} GiB, btrfs data pool on the rest, no LUKS"
ESP_MIB=4096
ENCRYPT=none
SYS_GIB=256
SWAP=zram
SERIAL_CONSOLE=0
# data pool subvolumes: name:mountpoint[:nocow]
DATA_SUBVOLS="@games:/data/games @emulation:/data/emulation @ml:/data/ml @vm:/data/vm:nocow @recordings:/data/recordings @containers:/var/lib/containers"
