/*
 * Letterpress for TeamSpeak 3, Letterpress.qss again for dark mode - GENERATED by bin/gen-windows-look.py from themes/washi (Boulevardier); do not edit.
 * TeamSpeak 3.6 and later add <style>_darkmode.qss (and _chat_darkmode.qss) while Windows
 * is dark. This repeats Letterpress.qss, so the theme holds whether TeamSpeak layers it
 * over that sheet or reads it alone.
 */

QWidget {
  background-color: #1c140f;
  color: #e6d6cb;
  selection-background-color: #3a2a22;
  selection-color: #e6d6cb;
  alternate-background-color: #16100c;
}

QWidget:disabled {
  color: #716158;
}

QToolTip {
  background-color: #2e211a;
  color: #e6d6cb;
  border: 1px solid #403731;
  padding: 3px;
}

QMenuBar,
QMenu {
  background-color: #16100c;
}

QMenu {
  border: 1px solid #403731;
}

QMenuBar::item:selected,
QMenu::item:selected {
  background-color: #3a2a22;
  color: #e6d6cb;
}

QMenu::separator {
  height: 1px;
  background-color: #403731;
  margin: 3px 6px;
}

QAbstractItemView {
  background-color: #16100c;
  border: 1px solid #403731;
  outline: 0;
}

QAbstractItemView::item:hover {
  background-color: #2c241e;
}

QAbstractItemView::item:selected {
  background-color: #3a2a22;
  color: #e6d6cb;
}

QHeaderView::section {
  background-color: #16100c;
  color: #ac9c92;
  border: 0;
  border-bottom: 1px solid #403731;
  padding: 3px 6px;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QAbstractSpinBox,
QComboBox {
  background-color: #16100c;
  border: 1px solid #403731;
  padding: 2px 4px;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QAbstractSpinBox:focus,
QComboBox:focus {
  border-color: #c0442b;
}

QComboBox::drop-down {
  border: 0;
  width: 16px;
}

QComboBox::down-arrow,
QAbstractSpinBox::down-arrow {
  width: 0;
  height: 0;
  border-left: 4px solid transparent;
  border-right: 4px solid transparent;
  border-top: 5px solid #ac9c92;
}

QAbstractSpinBox::up-arrow {
  width: 0;
  height: 0;
  border-left: 4px solid transparent;
  border-right: 4px solid transparent;
  border-bottom: 5px solid #ac9c92;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
  border: 0;
  width: 14px;
}

QPushButton {
  background-color: #2e211a;
  border: 1px solid #403731;
  padding: 3px 12px;
}

QPushButton:hover {
  background-color: #3a2a22;
}

QPushButton:pressed,
QPushButton:checked {
  background-color: #483830;
}

QPushButton:default {
  border-color: #c0442b;
}

QToolButton {
  background-color: transparent;
  border: 1px solid transparent;
  padding: 2px;
}

QToolButton:hover {
  background-color: #2e211a;
  border-color: #403731;
}

QToolButton:pressed,
QToolButton:checked {
  background-color: #3a2a22;
}

QTabWidget::pane {
  border: 1px solid #403731;
}

QTabBar::tab {
  background-color: #1c140f;
  color: #ac9c92;
  border: 0;
  border-bottom: 2px solid transparent;
  padding: 4px 12px;
}

QTabBar::tab:hover {
  color: #e6d6cb;
}

QTabBar::tab:selected {
  color: #e6d6cb;
  border-bottom: 2px solid #c0442b;
}

QScrollBar:vertical {
  background-color: #1c140f;
  width: 10px;
  margin: 0;
}

QScrollBar:horizontal {
  background-color: #1c140f;
  height: 10px;
  margin: 0;
}

QScrollBar::handle:vertical {
  background-color: #3a2a22;
  min-height: 24px;
}

QScrollBar::handle:horizontal {
  background-color: #3a2a22;
  min-width: 24px;
}

QScrollBar::handle:hover {
  background-color: #716158;
}

QScrollBar::add-line,
QScrollBar::sub-line {
  width: 0;
  height: 0;
  border: 0;
}

QScrollBar::add-page,
QScrollBar::sub-page {
  background: none;
}

QGroupBox {
  border: 1px solid #403731;
  margin-top: 14px;
  padding-top: 4px;
}

QGroupBox::title {
  subcontrol-origin: margin;
  left: 8px;
  padding: 0 4px;
  color: #ac9c92;
}

QCheckBox,
QRadioButton {
  background-color: transparent;
}

QProgressBar {
  background-color: #16100c;
  border: 1px solid #403731;
  text-align: center;
}

QProgressBar::chunk {
  background-color: #c0442b;
}

QSlider::groove:horizontal {
  height: 2px;
  background-color: #403731;
}

QSlider::sub-page:horizontal {
  background-color: #c0442b;
}

QSlider::handle:horizontal {
  background-color: #e6d6cb;
  width: 8px;
  margin: -5px 0;
  border-radius: 4px;
}

QSplitter::handle,
QMainWindow::separator {
  background-color: #403731;
}

QStatusBar {
  background-color: #16100c;
  color: #ac9c92;
}

QStatusBar::item {
  border: 0;
}

QDockWidget {
  color: #ac9c92;
}

QDockWidget::title {
  background-color: #16100c;
  padding: 4px;
}

TextBrowser,
InfoFrame,
ChatLineEdit {
  background-color: #1c140f;
}
