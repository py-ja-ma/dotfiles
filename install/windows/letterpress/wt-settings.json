{
  "defaultProfile": "{574e775e-4f2a-5b96-ac1e-a2962a402336}",
  "theme": "letterpress",
  "themes": [
    {
      "name": "letterpress",
      "window": {
        "applicationTheme": "dark",
        "useMica": false
      },
      "tabRow": {
        "background": "#1c140fff",
        "unfocusedBackground": "#1c140fff"
      },
      "tab": {
        "background": "terminalBackground",
        "unfocusedBackground": "#1c140fff",
        "showCloseButton": "hover"
      }
    }
  ],
  "profiles": {
    "defaults": {
      "colorScheme": "Washi",
      "font": {
        "face": "Monaspace Xenon, Symbols Nerd Font Mono",
        "size": 12,
        "features": {
          "calt": 1,
          "liga": 1,
          "ss01": 1,
          "ss02": 1,
          "ss03": 1
        }
      },
      "cursorShape": "bar",
      "padding": "10",
      "opacity": 100,
      "useAcrylic": false,
      "bellStyle": [
        "window",
        "taskbar"
      ],
      "historySize": 20000,
      "adjustIndistinguishableColors": "never"
    }
  }
}
