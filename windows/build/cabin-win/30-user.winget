# yaml-language-server: $schema=https://aka.ms/configuration-dsc-schema/0.2
#
# windows/build/cabin-win/30-user.winget - rendered by bin/render-windows.sh from
# windows/hosts/cabin-win.nix and what it names; edit those, never this (decisions/0020).
# Phase 30, apps; scope user: pj's own context (HKCU is pj's; never run it as SYSTEM).
# dram.ps1 (or converge.ps1) applies the documents in manifest.json's order, from build\:
#   winget configure -f C:\ProgramData\dram\build\30-user.winget --accept-configuration-agreements --disable-interactivity
properties:
  configurationVersion: "0.2.0"
  resources:
    # --- desktop (windows/roles/desktop.nix, packages/winget/desktop.txt) ---
    - resource: "Microsoft.WinGet.DSC/WinGetPackage"
      id: "spotify"
      directives:
        description: "Spotify (Microsoft Store source)"
        allowPrerelease: true
      settings:
        id: "9NCBCSZSJRSB"
        source: "msstore"
    # --- dev (windows/roles/dev.nix, packages/winget/dev.txt) ---
    - resource: "PSDscResources/Script"
      id: "vscodium-open-remote-ssh"
      directives:
        description: "Open Remote - SSH in VSCodium (jeanp413, MIT, Open VSX; accepted 2026-10-11), not Open Remote - WSL"
        allowPrerelease: true
      settings:
        GetScript: "& ([scriptblock]::Create([IO.File]::ReadAllText('C:\\ProgramData\\dram\\units\\vscodium-open-remote-ssh.ps1'))) -Mode Get"
        TestScript: "& ([scriptblock]::Create([IO.File]::ReadAllText('C:\\ProgramData\\dram\\units\\vscodium-open-remote-ssh.ps1'))) -Mode Test"
        SetScript: "& ([scriptblock]::Create([IO.File]::ReadAllText('C:\\ProgramData\\dram\\units\\vscodium-open-remote-ssh.ps1'))) -Mode Set"
