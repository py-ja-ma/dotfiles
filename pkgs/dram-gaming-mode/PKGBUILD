# shellcheck disable=SC2034,SC2154
# [dram] own package (UPSTREAM own:), decisions/0012; README.md and REVIEW.md beside it.
# Session switching between Desktop and Gaming Mode for ly, the Hyprland "Gaming Mode"
# session, and uinput for Steam Input. The sources are the files next to this PKGBUILD.

pkgname=dram-gaming-mode
pkgver=2026.10.11
pkgrel=3
pkgdesc="Desktop/Gaming Mode sessions and switching for ly (dram)"
arch=('any')
license=('LicenseRef-dram') # this repo's own code; no license file in the repo yet
depends=('ly' 'polkit' 'hyprland' 'systemd' 'bash' 'diffutils' 'gamescope-session-steam')
optdepends=('steam: what Gaming Mode runs')
source=('os-session-select' 'session-switch' 'ly-prepare' 'session-hyprland'
  'dram-session.conf' 'org.dram.session-select.policy'
  'dram-desktop.desktop' 'dram-gaming.desktop' 'dram-gaming-mode.desktop' 'uinput.conf')
sha256sums=('c7555e3d902c4a957dfd1fe516075139db044ab17d21279a512f3e460f54aa46'
            '989db85be7c53bf4c60d87ff41ad8642cc0cfede851d2ddc4b9469cfc057adec'
            'd274c691a5530c88bb2698b341f1ff32f2443c3637a4ed629cc1efa2c01a4b62'
            'a5ca44fef98f7daede29f4f178cf4db2b8495517dba49079e7ec83cae01fde55'
            '4d5588c4760433aa9fec2852fb0e5726160a784d7e6299836cfb8f2ad6b046f8'
            '29a9245601a53a8946ddb3606781f95c7b322f9e590cd41219a877dce634cee1'
            '3a5847d9f038eb89f346c96b4abd5ebc32f4963ce49f4d975cd2213833a26454'
            '45cd3c7655e5d0f30a38252af15893ca468ee9b3aba8354f4646da57f63acc29'
            '5a1b26038b853682234b9079fcd9c624df7738194e017aa10c11ef81b8bff97b'
            '49cbbfdae3bcc9ae0a20025978b316fb55f0f8391b4770eceefdf7dae4a15d4c')

package() {
  install -Dm755 os-session-select "$pkgdir/usr/lib/os-session-select"
  install -Dm755 -t "$pkgdir/usr/lib/dram" session-switch ly-prepare session-hyprland
  install -Dm644 dram-session.conf "$pkgdir/usr/lib/systemd/system/ly@.service.d/dram-session.conf"
  install -Dm644 org.dram.session-select.policy "$pkgdir/usr/share/polkit-1/actions/org.dram.session-select.policy"
  install -Dm644 -t "$pkgdir/usr/share/wayland-sessions" dram-desktop.desktop dram-gaming.desktop
  install -Dm644 dram-gaming-mode.desktop "$pkgdir/usr/share/applications/dram-gaming-mode.desktop"
  install -Dm644 uinput.conf "$pkgdir/usr/lib/modules-load.d/dram-uinput.conf"
}
