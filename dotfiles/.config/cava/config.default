# cava — audio visualizer, Letterpress (docs/design/shell-and-bars/terminal.md, "TUI monitors").
# ~/.config/cava/config is seeded from this file by dram-theme on first run; the
# [color] block below is the washi one and is replaced from themes/<t>/cava.theme
# on every switch (bin/gen-tui-themes.py writes those). Thin bars, one accent.
[general]
framerate = 60
bars = 0
bar_width = 1
bar_spacing = 1

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo

[color]
gradient = 1
gradient_count = 3
gradient_color_1 = '#662a1c'
gradient_color_2 = '#973824'
gradient_color_3 = '#c0442b'
foreground = '#e6d6cb'
background = default
[smoothing]
noise_reduction = 0.77
