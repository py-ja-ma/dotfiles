/* rofi — replaces wofi (unmaintained). Text-only like the old wofi setup
   (I dislike mismatched app icons). Letterpress: the list is set in the
   house mono; the entry's Fraunces and the paper/hairline/accent live in the
   theme file, which is GENERATED from rofi/theme.rasi.tmpl by
   bin/gen-rofi-themes.py (dotfiles/.config/rofi/README.md). */
configuration {
    modes: "drun,run";
    font: "Monaspace Xenon 12";
    show-icons: false;
    display-drun: "apps";
    display-run: "run";
    drun-display-format: "{name}";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    terminal: "kitty";
}
@theme "~/.config/themes/current/rofi.rasi"
