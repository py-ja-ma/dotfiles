/* solarized-paper for rofi — Letterpress: flat paper, one hairline, one accent ink.
   GENERATED by bin/gen-rofi-themes.py from this theme's waybar.css + palette.lua.
   Edit the template (rofi/theme.rasi.tmpl) or the palette, then re-run the
   generator — never this file by hand. */
* {
    bg:        #fdf6e3f5;
    bg-alt:    #e4ddc8;
    surface:   #948d76;
    fg:        #073642;
    muted:     #586e75;
    accent:    #b58900;
    red:       #ca2522;
    hairline:  #0736422e;

    background-color: transparent;
    text-color: @fg;
}

window {
    width: 560px;
    border: 1px;
    border-color: @hairline;
    border-radius: 3px;
    background-color: @bg;
    padding: 18px 22px 16px 22px;
}

mainbox {
    spacing: 10px;
}

/* the search line: a Fraunces entry sitting on one accent rule. Fraunces has
   no Cyrillic, so the Russian placeholder is Pango markup in EB Garamond
   Italic (the prompt's face, sized to Fraunces 22's x-height) — typed Latin
   text stays Fraunces; typed Russian falls to Literata (60-letterpress.conf). */
inputbar {
    children: [prompt, entry];
    background-color: transparent;
    border: 0px 0px 1px 0px;
    border-color: @accent;
    padding: 2px 2px 10px 2px;
    spacing: 12px;
}

prompt {
    font: "EB Garamond Italic 15";
    text-color: @muted;
    vertical-align: 0.5;
}

entry {
    font: "Fraunces 22";
    placeholder: "<span font_family='EB Garamond' style='italic' size='19456'>что ищем?</span>";
    placeholder-markup: true;
    placeholder-color: @muted;
    cursor-color: @accent;
    cursor-width: 2px;
}

listview {
    lines: 7;
    scrollbar: false;
    spacing: 2px;
    padding: 4px 0px 0px 0px;
}

/* a result is a line of type; the selected one carries a 2px accent rule on
   its left and is set in the accent ink — no fill, no pill */
element {
    padding: 7px 10px;
    border: 0px 0px 0px 2px;
    border-color: transparent;
    border-radius: 0px;
}

element selected.normal {
    background-color: transparent;
    border-color: @accent;
    text-color: @accent;
}

element-text {
    font: "Monaspace Xenon 12";
    background-color: transparent;
    text-color: inherit;
}

message {
    background-color: transparent;
    border: 0px 0px 1px 0px;
    border-color: @hairline;
    padding: 6px 2px;
}

textbox {
    font: "Literata Italic 13";
    text-color: @muted;
}
