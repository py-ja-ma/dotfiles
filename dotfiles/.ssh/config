#
# SSH client config — repo-safe generic defaults (dotfiles/.ssh/README.md).
# Homelab hosts/IPs/users live in ~/.ssh/config.d/*.conf (NOT in the repo).
# ssh_config is first-value-wins: the private Include must come FIRST so
# per-host settings override these defaults.
Include config.d/*.conf

Host *
    # keys / agent: the YubiKey first (a touch; `dram yubikey ssh` links the handle of the
    # key you carry, docs/security/identity/yubikeys.md; an absent key fails at once and ssh moves on), then
    # this device's own ed25519 key (passphrase in Proton Pass). IdentitiesOnly turns
    # ssh's default identities off, so the YubiKey handle has to be named here.
    IdentityFile ~/.ssh/id_ed25519_sk
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
    AddKeysToAgent yes

    # host-key policy: auto-accept NEW hosts, hard-fail on CHANGED keys
    StrictHostKeyChecking accept-new
    UpdateHostKeys yes

    # session robustness through NAT/dock changes
    ServerAliveInterval 30
    ServerAliveCountMax 3

    # multiplexing: one auth, instant reconnects (great for network gear)
    ControlMaster auto
    ControlPath ~/.ssh/sockets/%C
    ControlPersist 10m

    # explicit hardening (these are the defaults; stated as intent —
    # use ProxyJump, never agent forwarding, to reach nested hosts)
    ForwardAgent no
    ForwardX11 no
