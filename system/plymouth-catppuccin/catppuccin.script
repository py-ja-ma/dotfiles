# =============================================================================
#  Catppuccin Mocha — Plymouth "script" theme (self-contained, no image files)
#  Draws everything from text + math, so a missing asset can never break boot.
#    - background : Catppuccin base -> crust gradient
#    - spinner    : three dots (mauve / blue / peach) orbiting a common centre
#                   at different radii, speeds and directions
#    - graceful message / password handlers (in case they're ever needed)
# =============================================================================

Window.SetBackgroundTopColor(0.118, 0.118, 0.180);      # base   #1e1e2e
Window.SetBackgroundBottomColor(0.067, 0.067, 0.106);   # crust  #11111b

sw = Window.GetWidth();
sh = Window.GetHeight();
cx = sw / 2;
cy = sh / 2;

# ---- three orbiting dots --------------------------------------------------
# fields: r g b (colour), rad (orbit radius), spd (rad/frame), ph (start angle)
d[0].r = 0.796; d[0].g = 0.651; d[0].b = 0.969; d[0].rad = 30; d[0].spd =  0.055; d[0].ph = 0.0;   # mauve
d[1].r = 0.537; d[1].g = 0.706; d[1].b = 0.980; d[1].rad = 47; d[1].spd = -0.037; d[1].ph = 2.1;   # blue  (reverse)
d[2].r = 0.980; d[2].g = 0.702; d[2].b = 0.529; d[2].rad = 64; d[2].spd =  0.024; d[2].ph = 4.2;   # peach

for (i = 0; i < 3; i++) {
    d[i].image  = Image.Text("*", d[i].r, d[i].g, d[i].b, 1, "Sans Bold 22");
    d[i].sprite = Sprite(d[i].image);
    d[i].sprite.SetZ(11);
}

t = 0;
fun refresh_cb() {
    t++;
    for (i = 0; i < 3; i++) {
        a = d[i].ph + t * d[i].spd;
        d[i].sprite.SetX(cx + Math.Cos(a) * d[i].rad - d[i].image.GetWidth()  / 2);
        d[i].sprite.SetY(cy + Math.Sin(a) * d[i].rad - d[i].image.GetHeight() / 2);
    }
}
Plymouth.SetRefreshFunction(refresh_cb);

# ---- graceful message / password handling (safety) ------------------------
msg.sprite = Sprite();
fun message_cb(text) {
    msg.image = Image.Text(text, 0.804, 0.839, 0.957, 1, "Sans 12");   # text
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetX(cx - msg.image.GetWidth() / 2);
    msg.sprite.SetY(sh - 60);
    msg.sprite.SetZ(20);
}
Plymouth.SetMessageFunction(message_cb);

prompt.sprite = Sprite();
fun display_password_cb(prompt_text, bullets) {
    stars = "";
    for (i = 0; i < bullets; i++) { stars = stars + "*"; }
    prompt.image = Image.Text("password  " + stars, 0.804, 0.839, 0.957, 1, "Sans 14");
    prompt.sprite.SetImage(prompt.image);
    prompt.sprite.SetX(cx - prompt.image.GetWidth() / 2);
    prompt.sprite.SetY(cy + 130);
    prompt.sprite.SetZ(20);
}
Plymouth.SetDisplayPasswordFunction(display_password_cb);

fun display_normal_cb() {
    prompt.image = Image.Text("", 0, 0, 0);
    prompt.sprite.SetImage(prompt.image);
}
Plymouth.SetDisplayNormalFunction(display_normal_cb);
